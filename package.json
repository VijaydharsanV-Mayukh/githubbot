{
  "name": "github-discord-bot",
  "version": "1.0.0",
  "description": "Production-ready Discord bot for GitHub Webhooks hosted on Vercel",
  "main": "api/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && prisma db push --accept-data-loss && tsc",
    "start": "node dist/src/index.js",
    "deploy-commands": "ts-node scripts/deploy-commands.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate"
  },
  "keywords": [
    "github",
    "discord",
    "webhook",
    "bot",
    "typescript",
    "vercel",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "discord-interactions": "^3.4.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
